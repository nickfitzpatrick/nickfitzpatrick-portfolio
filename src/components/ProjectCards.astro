---
// Project cards (3a · 6a · 7a): one pinned section per Work Index category (#ai, #design, #ml, #data, #optimization, #product).
// Clicking a card unfolds it in place into the project's case study.
// Projects, hooks and categories come from src/data/work-index.js, in that file's order.
// Thumbnail, year and the case study itself come from the project's file in src/content/projects:
// its "## Problem / ## Approach / ## Results" sections are shown as Overview / Process / Outcome;
// any other headings are shown as written.
import '../styles/project-cards.css';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import manifest from '../data/images.json';
import { CATEGORIES, PROJECTS } from '../data/work-index.js';
import FishSpot from './FishSpot.astro';
import ProjectCaseCard from './ProjectCaseCard.astro';
import SelfCard from './SelfCard.astro';

type Optimised = { widths: number[]; base: string };
const entries = await getCollection('projects');
const image = (src?: string, min = 600) => {
  const m = src ? (manifest as Record<string, Optimised>)[src] : undefined;
  if (!m) return src ?? '';
  return `${m.base}-${m.widths.find((x) => x >= min) ?? m.widths.at(-1)}.webp`;
};
const LABELS: Record<string, string> = { Problem: 'Overview', Approach: 'Process', Results: 'Outcome' };
const caseStudy = (body: string) => {
  const parts = body.split(/^## +/m).slice(1).map((chunk) => {
    const [heading, ...rest] = chunk.split('\n');
    return { heading: heading.trim(), html: (marked.parse(rest.join('\n')) as string).replace(/preload="[^"]*"/g, 'preload="none"') };
  });
  // Only files written as Problem / Approach / Results are relabelled; others keep their own headings.
  const mapped = Object.keys(LABELS).every((h) => parts.some((x) => x.heading === h));
  return parts.map((x) => ({ label: mapped ? LABELS[x.heading] ?? x.heading : x.heading, html: x.html }));
};
const catName = (id: string) => CATEGORIES.find((c) => c.id === id)?.name ?? id;
const cards = (id: string) => PROJECTS.filter((p) => p.cats.includes(id)).map((p) => {
  const entry = entries.find((e) => e.slug === p.slug);
  if (!entry) throw new Error(`work-index.js: no project with slug "${p.slug}" in src/content/projects`);
  const meta = [['Year', entry.data.date?.slice(0, 4)], ['Categories', p.cats.map(catName).join(', ')]].filter(([, v]) => v);
  return { slug: p.slug, title: p.title, hook: p.hook, thumb: image(entry.data.image), big: image(entry.data.image, 1400), meta, sections: caseStudy(entry.body) };
});
// The category whose first card is this site (an empty outline the fish swims in; see SelfCard.astro).
const SELF_CAT = 'design';
const categories = CATEGORIES.map((c) => ({ ...c, projects: cards(c.id) })).filter((c) => c.projects.length);

// Layout of the 1280 x 800 stage, as designed: four card slots and the category's gold node.
// The node's starting place only; the script moves it to the end of the title (see project-cards.js).
const SLOTS = [[520, 70], [880, 150], [560, 430], [920, 500]];
const NODE = [240, 360];
const paths = SLOTS.map(([x, y]) => `M${NODE[0]} ${NODE[1]} C 380 ${NODE[1]}, ${x - 140} ${y + 100}, ${x} ${y + 100}`);
const pad = (v: number) => String(v).padStart(2, '0');
// Titles with several words stack one word per line. The block stays centred on the gold node's
// height, and the range ticks move down to sit the same distance below the last line.
const TITLE_LINE = 96, TITLE_GAP = 34; // line height (= font size) and title-to-ticks gap, as designed
const titleLayout = (name: string) => {
  const words = name.split(/\s+/);
  const top = NODE[1] - 2 - (TITLE_LINE * words.length) / 2; // one line: 310, as designed
  return { words, top, ticks: top + TITLE_LINE * words.length + TITLE_GAP - 4 }; // one line: 440, as designed
};
---
{categories.map((cat) => {
  const P = cat.projects, self = cat.id === SELF_CAT ? 1 : 0, pages = Math.ceil((P.length + self) / 4);
  const title = titleLayout(cat.name);
  const nextOf = (i: number) => (P.length > 1 ? P[(i + 1) % P.length].title : undefined);
  return (
    <section class="pc" id={cat.id} data-pc data-pages={pages} aria-labelledby={`pc-${cat.id}`}>
      <div class="pc-pin">
        <div class="pc-stage">
          <h2 class="pc-title" id={`pc-${cat.id}`} data-fish-avoid style={`top:${title.top}px`} data-line={TITLE_LINE}>{title.words.map((w) => <span>{w} </span>)}</h2>
          <div class="pc-ticks" style={`top:${title.ticks}px`}>
            {pages > 1 && Array.from({ length: pages }, (_, k) => (
              <button type="button" class="pc-tick" data-k={k} data-snap><i></i>{pad(k * 4 + 1)}–{pad(Math.min(P.length + self, k * 4 + 4))}</button>
            ))}
          </div>
          {pages > 1 && <div class="pc-hint" aria-hidden="true">Scroll ↓</div>}
          {!self && <span class="pc-spot"><FishSpot scale={0.5} /></span>}
          <svg class="pc-net" width="1280" height="800" aria-hidden="true">
            {paths.map((d, s) => (
              <>
                <path d={d} data-s={s} id={`pc-${cat.id}-line-${s}`} data-slot={SLOTS[s].join(',')}></path>
                <circle r="3" fill="#d8b13a" data-s={s}><animateMotion dur="2.4s" repeatCount="indefinite" begin={`-${s * 0.7}s`}><mpath href={`#pc-${cat.id}-line-${s}`} /></animateMotion></circle>
              </>
            ))}
            <circle class="pc-node" cx={NODE[0]} cy={NODE[1]} r="5" fill="#d8b13a" />
            <circle class="pc-node" cx={NODE[0]} cy={NODE[1]} r="14" fill="none" stroke="#d8b13a55" />
          </svg>
          {self > 0 && <SelfCard slot={SLOTS[0]} />}
          {P.map((p, i) => <ProjectCaseCard p={p} i={i} category={cat.name} next={nextOf(i)} slot={SLOTS[(i + self) % 4]} />)}
        </div>
      </div>
      {Array.from({ length: pages - 1 }, () => <div class="pc-spacer" aria-hidden="true"></div>)}
      <div class="pc-list">
        <h2>{title.words.map((w) => <span>{w} </span>)}</h2>
        {self > 0 ? <SelfCard /> : <span class="pc-list-spot"><FishSpot scale={0.5} /></span>}
        {P.map((p, i) => <ProjectCaseCard p={p} i={i} category={cat.name} next={nextOf(i)} />)}
      </div>
    </section>
  );
})}

<script>
  import { initProjectCards } from '../scripts/project-cards.js';
  initProjectCards(document.querySelectorAll('[data-pc]'));
</script>

<style>
  /* where the fish rests while a category is pinned: the free space under the ticks */
  .pc-spot { position: absolute; left: 0; top: 0; width: 1280px; height: 800px; --spot-x: 330px; --spot-y: 610px; pointer-events: none; }
  .pc-list-spot { position: absolute; left: 0; top: 0; right: 0; height: 160px; --spot-x: 80%; --spot-y: 96px; pointer-events: none; }
</style>
