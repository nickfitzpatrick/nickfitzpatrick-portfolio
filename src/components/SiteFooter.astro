---
// Footer: seagrass swaying above the contact links and credits.
// The fish credit is required by its CC BY licence.
const links = [
  { href: 'https://github.com/nickfitzpatrick', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/n-fitzpatrick', label: 'LinkedIn' },
  { href: 'mailto:nicholasfitzpatrick@berkeley.edu', label: 'Email' },
];
---
<footer class="footer">
  <canvas class="footer__grass" aria-hidden="true"></canvas>
  <div class="footer__row">
    <nav class="footer__links" aria-label="Contact">
      {links.map((l) => <a href={l.href} data-snap>{l.label}</a>)}
    </nav>
    <p class="footer__credit">
      Fish: <a href="https://sketchfab.com/3d-models/betta-splendens-f4eeb7f50ad24873842bd954ad27d23b" data-snap>Betta Splendens</a>
      by <a href="https://sketchfab.com/VapTor" data-snap>BlueMesh</a>,
      <a href="https://creativecommons.org/licenses/by/4.0/" rel="license" data-snap>CC BY 4.0</a>. Textures and mesh compressed for the web.
    </p>
  </div>
</footer>

<script>
  import { initSeagrass } from '../scripts/seagrass.js';
  const c = document.querySelector('.footer__grass');
  if (c) initSeagrass(c);
</script>

<style>
  .footer { position: relative; z-index: var(--z-text); overflow: hidden; padding-top: 340px;
    font-family: var(--font-pc); -webkit-font-smoothing: antialiased; }
  .footer__grass { position: absolute; inset: 0 0 auto 0; width: 100%; height: 350px; display: block;
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent); mask-image: linear-gradient(to bottom, #000 45%, transparent); }
  .footer__row { position: relative; display: flex; justify-content: space-between; align-items: flex-start; gap: 48px; padding: 22px var(--gutter) 64px; }
  .footer a { color: var(--wi-ink); transition: color var(--dur-1) var(--ease-soft); }
  .footer a:hover, .footer a:focus-visible { color: var(--wi-teal); }
  .footer__links { display: flex; gap: 22px; font-size: 17px; }
  .footer__credit { margin: 0; max-width: 470px; font-size: 13px; line-height: 1.6; color: var(--wi-mute); }
  .footer__credit a { border-bottom: 1px solid var(--wi-mute); }
  @media (max-width: 640px) {
    .footer { padding-top: 240px; }
    .footer__grass { height: 250px; }
    .footer__row { flex-direction: column; gap: 24px; padding: 16px var(--gutter) 48px; }
  }
  @media (max-width: 45em) {
    .footer__row { padding-bottom: calc(var(--space-7) + env(safe-area-inset-bottom)); } /* clears the bottom nav */
  }
</style>
