---
// Footer: contact links and credits. The fish credit is required by its CC BY licence.
const links = [
  { href: 'https://github.com/nickfitzpatrick', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/n-fitzpatrick', label: 'LinkedIn' },
  { href: 'mailto:nicholasfitzpatrick@berkeley.edu', label: 'Email' },
];
---
<footer class="footer">
  <div class="footer__inner">
    <ul class="footer__links">
      {links.map((l) => <li><a class="link" href={l.href} data-snap>{l.label}</a></li>)}
    </ul>
    <p class="footer__credit">
      Fish: <a class="link" href="https://sketchfab.com/3d-models/betta-splendens-f4eeb7f50ad24873842bd954ad27d23b" data-snap>Betta Splendens</a>
      by <a class="link" href="https://sketchfab.com/VapTor" data-snap>BlueMesh</a>,
      <a class="link" href="https://creativecommons.org/licenses/by/4.0/" rel="license" data-snap>CC BY 4.0</a>. Textures and mesh compressed for the web.
    </p>
  </div>
</footer>

<style>
  .footer { position: relative; z-index: var(--z-text); padding: var(--space-6) var(--gutter) var(--space-5); border-top: 1px solid var(--line); }
  .footer__inner { max-width: var(--max); margin-inline: auto; display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-6); justify-content: space-between; align-items: baseline; }
  .footer__links { display: flex; gap: var(--space-4); font-size: var(--step-0); }
  .footer__credit { font-size: var(--step--1); color: var(--ink-3); max-width: var(--measure); }
  .footer__credit .link { color: var(--ink-2); background-size: 100% 1px; background-image: linear-gradient(var(--ink-3), var(--ink-3)); }
  .footer__credit .link:hover, .footer__credit .link:focus-visible { color: var(--ink); background-image: linear-gradient(currentColor, currentColor); }
  @media (max-width: 45em) {
    .footer { padding-bottom: calc(var(--space-7) + env(safe-area-inset-bottom)); } /* clears the bottom nav */
  }
</style>
