---
// The betta. One small canvas that follows the fish around the viewport, drawn
// between the media layer and the text layer. three.js and the model load
// after the page content; if WebGL or the model is unavailable the page simply
// has no fish.
---
<div class="fish" data-fish aria-hidden="true"><canvas class="fish__canvas"></canvas></div>

<script>
  import { initFish } from '../scripts/fish/index.js';
  initFish(document.querySelector('[data-fish]'));
</script>

<style>
  .fish { position: fixed; inset: 0 auto auto 0; width: 0; height: 0; z-index: var(--z-fish); pointer-events: none; }
  .fish__canvas {
    position: absolute; left: 0; top: 0; width: var(--fish-size); height: var(--fish-size);
    opacity: 0; transition: opacity var(--dur-slow) var(--ease-soft); will-change: transform;
  }
  :global(html[data-fish='ready']) .fish__canvas { opacity: 1; }
  :global(html[data-fish='ready']) .fish__canvas.is-away { opacity: 0; transition-duration: var(--dur-1); } /* slips out of sight when a card scrolls onto it */
  .fish__canvas.is-still { left: calc(var(--fish-size) / -2); top: calc(var(--fish-size) / -2); will-change: auto; } /* reduced motion: parked in the hero */
</style>
