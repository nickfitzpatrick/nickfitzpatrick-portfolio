---
// The site itself, as the first card in Design: an empty outline the fish swims in.
// Clicking it goes back to the top of the page (the script scrolls; without JS the link does).
// `slot` places it on the pinned stage; without it, it is the first card in the small-screen list.
import FishSpot from './FishSpot.astro';
interface Props { slot?: number[] }
const { slot } = Astro.props;
---
<a class="pc-card pc-self" href="#top" data-self aria-label="This site: back to the top" data-cursor="grow"
  style={slot ? `left:${slot[0]}px;top:${slot[1]}px` : undefined}>
  <div class="pc-edge"></div>
  <span class="pc-self-spot"><FishSpot scale={0.36} /></span>
</a>
