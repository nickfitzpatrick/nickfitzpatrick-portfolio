---
// One project, straight from the collection schema. Compact: fits one screen.
// The whole card is the link; the title straddles the image edge.
// data-fish-avoid tells the fish to stay off the card.
import type { CollectionEntry } from 'astro:content';
import manifest from '../data/images.json';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const d = project.data;
const [name, ...rest] = d.title.split(': ');
const sub = rest.join(': ');
const when = d.date
  ? new Date(`${d.date}-01T12:00:00`).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : null;

type Optimised = { width: number; height: number; widths: number[]; base: string };
const img = d.image ? (manifest as Record<string, Optimised>)[d.image] : undefined;
const srcset = (ext: string) => img!.widths.map((w) => `${img!.base}-${w}.${ext} ${w}w`).join(', ');
const sizes = '(max-width: 45em) 92vw, 56vw';
---
<article class="card" data-fish-avoid>
  <div class="card__media" data-reveal data-parallax>
    {img ? (
      <picture>
        <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
        <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
        <img src={`${img.base}-${img.widths.at(-1)}.webp`} width={img.width} height={img.height} alt="" loading="lazy" decoding="async" />
      </picture>
    ) : d.image && <img src={d.image} alt="" loading="lazy" decoding="async" />}
  </div>
  <div class="card__head">
    <h3 class="card__name"><a href={`/projects/${project.slug}`} data-cursor="grow">{name}</a></h3>
    {sub && <p class="card__sub">{sub}</p>}
  </div>
  <div class="card__body">
    <div class="card__copy">
      <p class="card__summary">{d.summary}</p>
      {d.award && <p class="card__award">{d.award}</p>}
    </div>
    <div class="card__foot">
      <dl class="card__facts">
        {when && <div><dt>Date</dt><dd>{when}</dd></div>}
        {d.status && <div><dt>Status</dt><dd>{d.status}</dd></div>}
        <div><dt>Built with</dt><dd>{d.tags.slice(0, 4).join(', ')}</dd></div>
      </dl>
      <span class="card__open" aria-hidden="true">Read the case study</span>
    </div>
  </div>
</article>

<style>
  .card { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); }

  .card__media {
    grid-column: 6 / -1; grid-row: 1; position: relative; z-index: var(--z-media);
    aspect-ratio: 16 / 10; overflow: hidden; background: #070707;
  }
  .card__media picture, .card__media img { width: 100%; height: 100%; }
  .card__media img { object-fit: cover; scale: 1.06; transition: scale var(--dur-slow) var(--ease-out); will-change: translate; }
  .card__media::after { /* scrim under the overlapping title */
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(var(--scrim), 0.82) 0%, rgba(var(--scrim), 0.45) 26%, rgba(var(--scrim), 0) 56%),
      linear-gradient(0deg, rgba(var(--scrim), 0.6) 0%, rgba(var(--scrim), 0) 42%);
  }
  .card:hover .card__media img { scale: 1.09; }
  .card:active .card__media img { scale: 1.07; transition-duration: var(--dur-1); }

  .card__head {
    grid-column: 5 / 11; grid-row: 1; align-self: end; position: relative; z-index: var(--z-text);
    padding-bottom: var(--space-4); pointer-events: none;
  }
  .card__name { font-size: var(--step-2); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); }
  .card__name a { pointer-events: auto; }
  .card__name a::after { content: ''; position: absolute; inset: 0; } /* stretches the link over the card */
  .card__name a:focus-visible { outline: none; }
  .card:has(.card__name a:focus-visible) { outline: 1.5px solid var(--ink); outline-offset: var(--space-3); }
  .card__sub { margin-top: var(--space-2); font-size: var(--step-0); line-height: 1.35; color: var(--ink); max-width: 22rem; }

  .card__body {
    grid-column: 1 / 5; grid-row: 1; position: relative; z-index: var(--z-text);
    display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-4);
    font-size: var(--step--1); pointer-events: none;
  }
  .card__summary { font-size: var(--step-0); color: var(--ink-2); max-width: var(--measure); }
  .card__award { margin-top: var(--space-3); color: var(--ink); }
  .card__facts { display: grid; gap: var(--space-1); }
  .card__facts div { display: grid; grid-template-columns: 6rem 1fr; }
  .card__facts dt { color: var(--ink-3); }
  .card__facts dd { color: var(--ink-2); }
  .card__open {
    display: inline-block; margin-top: var(--space-4); padding-block: var(--space-1); color: var(--ink);
    background: linear-gradient(currentColor, currentColor) 0 100% / 2.5rem 1px no-repeat;
    transition: background-size var(--dur-3) var(--ease-out);
  }
  .card:hover .card__open, .card:has(a:focus-visible) .card__open { background-size: 100% 1px; }

  /* Reveal once, when scrolled into view (script adds .is-in). Visible by default without JS. */
  :global(.js) .card__media[data-reveal] { opacity: 0; transform: translate3d(0, 1.5rem, 0); }
  :global(.js) .card__media[data-reveal].is-in {
    opacity: 1; transform: none;
    transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out);
  }
  :global(.js) .card__media[data-reveal]:not(.is-in) img { scale: 1.16; }

  @media (max-width: 45em) {
    .card { display: block; }
    .card__media::after { background: linear-gradient(0deg, rgba(var(--scrim), 0.88) 0%, rgba(var(--scrim), 0.35) 30%, rgba(var(--scrim), 0) 60%); }
    .card__head { margin-top: -1.9rem; padding: 0 var(--space-3) 0 0; }
    .card__body { margin-top: var(--space-4); }
    .card__facts div { grid-template-columns: 5.5rem 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .card__media[data-reveal] { opacity: 1; transform: none; }
    :global(.js) .card__media[data-reveal]:not(.is-in) img, .card:hover .card__media img { scale: 1.06; }
  }
</style>
