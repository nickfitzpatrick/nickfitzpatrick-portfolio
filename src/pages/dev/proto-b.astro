---
// Redesign prototype (direction B: betta). Scope: hero + one project card.
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Fish from '../../components/Fish.astro';
import FishSpot from '../../components/FishSpot.astro';
import MediaEffects from '../../components/MediaEffects.astro';
import NetworkGlow from '../../components/NetworkGlow.astro';
import italicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';

const projects = await getCollection('projects');
const project = projects.find((p) => p.slug === 'argus') ?? projects[0];
const sections = [{ id: 'top', label: 'Intro' }, { id: 'work', label: 'Work' }];
// Placeholder phrases for the looping lede: "I build ___". Edit freely; keep each under about 24 characters.
const builds = ['research tools', 'optimization models', 'data pipelines', 'AI prototypes', 'decision systems'];
---
<Site title="Redesign prototype" sections={sections} noindex>
  <link slot="head" rel="preload" href={italicUrl} as="font" type="font/woff2" crossorigin />
  <Fish />
  <Hero lines={['Nick', 'Fitzpatrick']} lede="I build" rotate={builds}>
    <NetworkGlow />
    <FishSpot loader />
  </Hero>
  <section class="work" id="work">
    <FishSpot scale={0.5} />
    <div class="work__inner">
      <h2 class="work__title">Selected work</h2>
      <ProjectCard project={project} />
    </div>
  </section>
  <MediaEffects />
</Site>

<style>
  .work { --spot-x: 84%; --spot-y: var(--space-5); position: relative; padding: var(--space-7) var(--gutter) var(--space-8); }
  .work__inner { max-width: var(--max); margin-inline: auto; }
  .work__title {
    position: relative; z-index: var(--z-text);
    font-size: var(--step-1); letter-spacing: var(--tracking-heading); color: var(--ink-2);
    margin-bottom: var(--space-5);
  }
  @media (max-width: 45em) {
    .work { --spot-x: 78%; --spot-y: var(--space-3); padding-block: var(--space-6) var(--space-7); }
    .work__title { margin-bottom: var(--space-4); }
  }
</style>
