---
// Home: hero, Work Index, then the project cards (one pinned section per Work Index category).
import Site from '../layouts/Site.astro';
import Hero from '../components/Hero.astro';
import WorkIndex from '../components/WorkIndex.astro';
import ProjectCards from '../components/ProjectCards.astro';
import Fish from '../components/Fish.astro';
import FishSpot from '../components/FishSpot.astro';
import NetworkGlow from '../components/NetworkGlow.astro';
import italicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';

const sections = [{ id: 'top', label: 'Intro' }, { id: 'work', label: 'Work' }];
// Phrases for the looping lede: "I build ___". Keep each under about 24 characters (the line never wraps).
const builds = [
  'AI products',
  'agentic AI',
  'prototypes',
  'agentic workflows',
  'decision systems',
  'product roadmaps',
  'customer demos',
  'data dashboards',
  'analytics pipelines',
  'optimization models',
  'ML models',
  'computer vision models',
  'LLM evals',
  'RAG pipelines',
  'design tools',
  'user interfaces',
  'robot learning models',
  'interactive websites',
];
---
<Site title="Home" sections={sections}>
  <link slot="head" rel="preload" href={italicUrl} as="font" type="font/woff2" crossorigin />
  {/* Switzer for the project cards, from Fontshare. Loaded without blocking the page; swap for self-hosted files when available. */}
  <Fish />
  <Hero lines={['Nick', 'Fitzpatrick']} lede="I build" rotate={builds}>
    <NetworkGlow />
    <FishSpot loader />
  </Hero>
  <section class="work" id="work">
    <FishSpot scale={0.5} />
    <WorkIndex />
  </section>
  <ProjectCards />
</Site>

<style>
  /* the fish rests in the right-hand margin of the Work Index (it may only swim the section's edges) */
  .work { --spot-x: 94%; --spot-y: 46%; position: relative; }
  @media (max-width: 767px) {
    .work { --spot-x: 78%; --spot-y: 0%; } /* no side margin on phones: it waits just above the section */
  }
</style>
